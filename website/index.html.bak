                    <!-- Project Type Selection -->
                    <div id="projectTypeSelection" style="margin-bottom: 20px;">
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                            <button type="button" class="project-type-btn" data-type="residential" onclick="selectProjectType('residential')">
                                Residential
                            </button>
                            <button type="button" class="project-type-btn" data-type="commercial" onclick="selectProjectType('commercial')">
                                Commercial
                            </button>
                        </div>
                    </div>

                    <!-- Form Fields (hidden until project type is selected) -->
                    <div id="formContent" style="display: none !important;">
                        <!-- Full Name Row -->
                        <div class="form-row">
                            <div class="form-group">
                                <input type="text" id="name" name="name" placeholder="Full Name" required>
                            </div>
                        </div>

                        <!-- Business Name Row (Commercial) -->
                        <div id="commercialFields" class="form-row" style="display: none;">
                            <div class="form-group">
                                <input type="text" id="businessName" name="businessName" placeholder="Business Name">
                            </div>
                        </div>

                        <!-- Phone Row -->
                        <div class="form-row">
                            <div class="form-group">
                                <input type="tel" id="phone" name="phone" placeholder="Phone" required>
                            </div>
                        </div>

                        <!-- Email Row -->
                        <div class="form-row">
                            <div class="form-group">
                                <input type="email" id="email" name="email" placeholder="Email" required>
                            </div>
                        </div>

                        <!-- Property Address Row (Residential) -->
                        <div id="residentialFields" class="form-row" style="display: none;">
                            <div class="form-group">
                                <input type="text" id="address" name="address" placeholder="Property Address" required>
                            </div>
                        </div>

                        <!-- Business Address Row (Commercial only) -->
                        <div id="commercialAddressRow" class="form-row" style="display: none;">
                            <div class="form-group">
                                <input type="text" id="businessAddress" name="businessAddress" placeholder="Business Address">
                            </div>
                        </div>

                        <!-- Residential Services -->
                        <div id="residentialServices" class="form-group" style="display: none;">
                            <div style="display: flex; flex-direction: column; gap: 5px;">
                                <label style="display: flex; align-items: center; font-weight: 400;">
                                    <input type="checkbox" name="service" value="window-exterior" style="margin-right: 8px;">
                                    Window Cleaning Exterior
                                </label>
                                <label style="display: flex; align-items: center; font-weight: 400;">
                                    <input type="checkbox" name="service" value="window-exterior-interior" style="margin-right: 8px;">
                                    Window Cleaning Exterior + Interior
                                </label>
                                <label style="display: flex; align-items: center; font-weight: 400;">
                                    <input type="checkbox" name="service" value="solar" style="margin-right: 8px;">
                                    Solar Panel Cleaning
                                </label>
                                <label style="display: flex; align-items: center; font-weight: 400;">
                                    <input type="checkbox" name="service" value="screen" style="margin-right: 8px;">
                                    Screen Cleaning
                                </label>
                                <label style="display: flex; align-items: center; font-weight: 400;">
                                    <input type="checkbox" name="service" value="track-detailing" style="margin-right: 8px;">
                                    Track Detailing
                                </label>
                            </div>
                        </div>

                        <!-- Commercial Services -->
                        <div id="commercialServices" class="form-group" style="display: none;">
                            <div style="display: flex; flex-direction: column; gap: 8px;">
                                <label style="display: flex; align-items: center; font-weight: 400;">
                                    <input type="checkbox" name="service" value="window-exterior" style="margin-right: 8px;">
                                    Window Cleaning Exterior
                                </label>
                                <label style="display: flex; align-items: center; font-weight: 400;">
                                    <input type="checkbox" name="service" value="window-exterior-interior" style="margin-right: 8px;">
                                    Window Cleaning Exterior + Interior
                                </label>
                                <label style="display: flex; align-items: center; font-weight: 400;">
                                    <input type="checkbox" name="service" value="solar" style="margin-right: 8px;">
                                    Solar Panel Cleaning
                                </label>
                                <label style="display: flex; align-items: center; font-weight: 400;">
                                    <input type="checkbox" name="service" value="storefront" style="margin-right: 8px;">
                                    Store Window Cleaning
                                </label>
                            </div>
                        </div>

                        <div class="form-group">
                            <div style="background: rgba(255, 255, 255, 0.95); border: 1px solid rgba(255, 255, 255, 0.3); border-radius: 8px; padding: 12px; display: flex; flex-direction: column; gap: 12px;">
                                <textarea id="message" name="message" placeholder="Tell Us About Your Project" required style="min-height: 120px; border: none; background: transparent; padding: 0; font-family: 'Open Sans', sans-serif; font-size: 15px; color: #333; resize: vertical;"></textarea>
                                <input type="file" id="photos" name="photos" multiple accept="image/*" style="opacity: 0; position: absolute; width: 0; height: 0;">
                                <label for="photos" style="font-size: 14px; color: #333; cursor: pointer;">Add photos</label>
                                <div id="filesDisplayed" style="font-size: 12px; color: #0EA5B5; margin: 0; display: none;"></div>
                                <p style="font-size: 12px; color: #666; margin: 0;">You can select multiple photos. Max 10MB per file.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Get Your Quote Button - inside form, outside formContent -->
                    <button type="button" class="btn btn-primary pricing-btn" onclick="submitForm()">GET YOUR QUOTE</button>
                </form>
            </div>
        </div>
    </section>

    <script>
        function selectProjectType(type) {
            // Update button active states
            document.querySelectorAll('.project-type-btn').forEach(btn => {
                btn.classList.remove('active');
                btn.classList.remove('highlight');
            });
            document.querySelector(`[data-type="${type}"]`).classList.add('active');

            // Show form content
            document.getElementById('formContent').style.display = 'block';

            // Show/hide residential or commercial fields
            const isResidential = type === 'residential';
            document.getElementById('residentialFields').style.display = isResidential ? 'block' : 'none';
            document.getElementById('commercialFields').style.display = isResidential ? 'none' : 'block';
            document.getElementById('commercialAddressRow').style.display = isResidential ? 'none' : 'block';
            document.getElementById('residentialServices').style.display = isResidential ? 'block' : 'none';
            document.getElementById('commercialServices').style.display = isResidential ? 'none' : 'block';
        }

        function submitForm() {
            // Check if a project type is selected
            const activeBtn = document.querySelector('.project-type-btn.active');

            if (!activeBtn) {
                // Highlight both buttons to indicate selection is required
                document.querySelectorAll('.project-type-btn').forEach(btn => {
                    btn.classList.add('highlight');
                    // Remove highlight class after animation
                    setTimeout(() => {
                        btn.classList.remove('highlight');
                    }, 600);
                });
                return;
            }

            // If type is selected, submit the form
            document.querySelector('form.contact-form').submit();
        }
    </script>

    <!-- Footer -->
    <footer>
        <div class="footer-content">
            <div class="footer-section">
                <h3>ClearVue Exterior</h3>
                <p>Professional window and exterior cleaning services in Orange County, California.</p>
            </div>
            <div class="footer-section">
                <h3>Services</h3>
                <ul>
                    <li><a href="#services">Window Cleaning</a></li>
                    <li><a href="#services">Solar Panel Cleaning</a></li>
                    <li><a href="#services">Screen Cleaning</a></li>
                    <li><a href="#services">Track Cleaning</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h3>Company</h3>
                <ul>
                    <li><a href="#why">Why ClearVue</a></li>
                    <li><a href="#contact">Contact</a></li>
                    <li><a href="#">Privacy Policy</a></li>
                    <li><a href="#">Terms of Service</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h3>Connect</h3>
                <ul>
                    <li><a href="#">Facebook</a></li>
                    <li><a href="#">Instagram</a></li>
                    <li><a href="#">Google Reviews</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 ClearVue Exterior. All rights reserved. | Cleaner Views. Brighter Living.</p>
        </div>
    </footer>

    <script>
        // Scroll-driven canvas animation (same as before)
        class ScrollDrivenAnimation {
            constructor() {
                this.canvas = document.getElementById('heroCanvas');
                this.ctx = this.canvas.getContext('2d', { alpha: false });

                this.images = [
                    'assets/references/clearvue-hero-reference_2.png'
                ];

                this.loadedImages = [];
                this.scrollProgress = 0;
                this.isLoading = true;

                this.resizeCanvas();
                this.loadImages();
                this.setupEventListeners();
                this.render();
            }

            resizeCanvas() {
                this.canvas.width = window.innerWidth;
                this.canvas.height = window.innerHeight;
            }

            loadImages() {
                let loadedCount = 0;

                this.images.forEach((src, index) => {
                    const img = new Image();
                    img.crossOrigin = 'anonymous';
                    img.onload = () => {
                        this.loadedImages[index] = img;
                        loadedCount++;
                        if (loadedCount === this.images.length) {
                            this.isLoading = false;
                        }
                    };
                    img.onerror = () => {
                        console.warn(`Failed to load image: ${src}`);
                        loadedCount++;
                        if (loadedCount === this.images.length) {
                            this.isLoading = false;
                        }
                    };
                    img.src = src;
                });
            }

            setupEventListeners() {
                window.addEventListener('scroll', () => this.updateScroll());
                window.addEventListener('resize', () => this.resizeCanvas());
            }

            updateScroll() {
                const heroHeight = window.innerHeight;
                const scrolled = Math.max(0, window.scrollY - heroHeight);
                const maxScroll = heroHeight;
                this.scrollProgress = Math.min(1, scrolled / maxScroll);
            }

            drawImage(img, phase) {
                if (!img) return;

                const canvas = this.canvas;
                const ctx = this.ctx;

                const zoom = 1 + phase * 0.15;
                const panX = Math.sin(phase * Math.PI * 2) * 20;
                const panY = Math.cos(phase * Math.PI * 2) * 15;

                const imgAspect = img.width / img.height;
                const canvasAspect = canvas.width / canvas.height;

                let drawWidth, drawHeight, drawX, drawY;

                if (imgAspect > canvasAspect) {
                    drawHeight = canvas.height * zoom;
                    drawWidth = drawHeight * imgAspect;
                } else {
                    drawWidth = canvas.width * zoom;
                    drawHeight = drawWidth / imgAspect;
                }

                drawX = (canvas.width - drawWidth) / 2 + panX;
                drawY = (canvas.height - drawHeight) / 2 + panY;

                ctx.drawImage(img, drawX, drawY, drawWidth, drawHeight);
            }

            blendImages(img1, img2, blendFactor) {
                if (!img1 || !img2) return;

                this.drawImage(img1, 0);
                this.ctx.globalAlpha = blendFactor;
                this.drawImage(img2, blendFactor);
                this.ctx.globalAlpha = 1;
            }

            render = () => {
                const ctx = this.ctx;
                const progress = this.scrollProgress;

                ctx.fillStyle = '#0D1B2A';
                ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);

                if (this.isLoading || this.loadedImages.length === 0) {
                    ctx.fillStyle = '#666';
                    ctx.font = '16px Open Sans';
                    ctx.textAlign = 'center';
                    ctx.fillText('Loading premium visuals..', this.canvas.width / 2, this.canvas.height / 2);
                } else {
                    // Single image with subtle zoom effect
                    const zoomProgress = Math.min(progress * 0.2, 0.15);
                    this.drawImage(this.loadedImages[0], zoomProgress);
                }

                requestAnimationFrame(this.render);
            };
        }

        // Initialize animations
        document.addEventListener('DOMContentLoaded', () => {
            new ScrollDrivenAnimation();
        });

        // Smooth scroll functions
        function scrollToServices() {
            document.getElementById('services').scrollIntoView({ behavior: 'smooth' });
        }

        function scrollToContact() {
            document.getElementById('contact').scrollIntoView({ behavior: 'smooth' });
        }

        // Navigate to service page
        function navigateToService(url) {
            window.location.href = url;
        }

        // Service Areas Toggle (kept for backward compatibility if needed)
        function toggleServiceArea(element) {
            const regionAreas = element.nextElementSibling;
            const toggle = element.querySelector('.area-toggle');

            if (regionAreas && regionAreas.style.display === 'none') {
                regionAreas.style.display = 'block';
                toggle.textContent = '−';
                regionAreas.classList.add('open');
            } else if (regionAreas) {
                regionAreas.style.display = 'none';
                toggle.textContent = '+';
                regionAreas.classList.remove('open');
            }
        }

        // Window Cleaning Type - mutually exclusive
        // Handle Residential Services
        const residentialServices = document.getElementById('residentialServices');
        if (residentialServices) {
            const residentialWindowExterior = residentialServices.querySelector('input[value="window-exterior"]');
            const residentialWindowExteriorInterior = residentialServices.querySelector('input[value="window-exterior-interior"]');

            if (residentialWindowExterior && residentialWindowExteriorInterior) {
                residentialWindowExterior.addEventListener('change', function() {
                    if (this.checked) {
                        residentialWindowExteriorInterior.checked = false;
                    }
                });

                residentialWindowExteriorInterior.addEventListener('change', function() {
                    if (this.checked) {
                        residentialWindowExterior.checked = false;
                    }
                });
            }
        }

        // Handle Commercial Services
        const commercialServices = document.getElementById('commercialServices');
        if (commercialServices) {
            const commercialWindowExterior = commercialServices.querySelector('input[value="window-exterior"]');
            const commercialWindowExteriorInterior = commercialServices.querySelector('input[value="window-exterior-interior"]');

            if (commercialWindowExterior && commercialWindowExteriorInterior) {
                commercialWindowExterior.addEventListener('change', function() {
                    if (this.checked) {
                        commercialWindowExteriorInterior.checked = false;
                    }
                });

                commercialWindowExteriorInterior.addEventListener('change', function() {
                    if (this.checked) {
                        commercialWindowExterior.checked = false;
                    }
                });
            }
        }

        // File upload display
        const photosInput = document.getElementById('photos');
        const filesDisplayed = document.getElementById('filesDisplayed');

        if (photosInput) {
            photosInput.addEventListener('change', function() {
                if (this.files.length > 0) {
                    let fileNames = '';
                    for (let i = 0; i < this.files.length; i++) {
                        fileNames += this.files[i].name;
                        if (i < this.files.length - 1) {
                            fileNames += ', ';
                        }
                    }
                    filesDisplayed.textContent = '✓ Files selected: ' + fileNames;
                    filesDisplayed.style.display = 'block';
                } else {
                    filesDisplayed.style.display = 'none';
                }
            });
        }

        // Form submission (basic)
        document.querySelector('.contact-form').addEventListener('submit', function(e) {
            e.preventDefault();
            alert('Thank you for your interest! We\'ll contact you soon to discuss your free estimate.');
            this.reset();
        });
    </script>
</body>
</html>
