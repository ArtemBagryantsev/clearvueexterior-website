    <script>
        function selectProjectType(type) {
            // Update button active states
            document.querySelectorAll('.project-type-btn').forEach(btn => {
                btn.classList.remove('active');
                btn.classList.remove('highlight');
            });
            document.querySelector(`[data-type="${type}"]`).classList.add('active');

            // Show form content
            document.getElementById('formContent').style.display = 'block';

            // Show/hide residential or commercial fields
            const isResidential = type === 'residential';
            document.getElementById('residentialFields').style.display = isResidential ? 'block' : 'none';
            document.getElementById('commercialFields').style.display = isResidential ? 'none' : 'block';
            document.getElementById('commercialAddressRow').style.display = isResidential ? 'none' : 'block';
            document.getElementById('residentialServices').style.display = isResidential ? 'block' : 'none';
            document.getElementById('commercialServices').style.display = isResidential ? 'none' : 'block';
        }

        function submitForm() {
            // Check if a project type is selected
            const activeBtn = document.querySelector('.project-type-btn.active');

            if (!activeBtn) {
                // Highlight both buttons to indicate selection is required
                document.querySelectorAll('.project-type-btn').forEach(btn => {
                    btn.classList.add('highlight');
                    // Remove highlight class after animation
                    setTimeout(() => {
                        btn.classList.remove('highlight');
                    }, 600);
                });
                return;
            }

            // If type is selected, submit the form
            document.querySelector('form.contact-form').submit();
        }
    </script>

